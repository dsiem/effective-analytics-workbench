{
  "name": "@dsiem/workbench-ui",
  "version": "0.1.0",
  "description": "Analytics workspace navigation, reports and interactive features for Foldkit applications",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "workspace.css",
    "css",
    "lucide-LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workbench-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./query-page": {
      "types": "./dist/query-page.d.ts",
      "workbench-source": "./src/query-page.ts",
      "import": "./dist/query-page.js"
    },
    "./findings": {
      "types": "./dist/findings.d.ts",
      "workbench-source": "./src/findings.ts",
      "import": "./dist/findings.js"
    },
    "./styles.css": "./styles.css",
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "workbench-source": "./src/assistant.ts",
      "import": "./dist/assistant.js"
    },
    "./record-explorer": {
      "types": "./dist/record-explorer.d.ts",
      "workbench-source": "./src/record-explorer.ts",
      "import": "./dist/record-explorer.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "workbench-source": "./src/workspace.ts",
      "import": "./dist/workspace.js"
    },
    "./run-page": {
      "types": "./dist/run-page.d.ts",
      "workbench-source": "./src/run-page.ts",
      "import": "./dist/run-page.js"
    },
    "./assistant-answer": {
      "types": "./dist/assistant-answer.d.ts",
      "workbench-source": "./src/assistant-answer.ts",
      "import": "./dist/assistant-answer.js"
    },
    "./workspace-frame": {
      "types": "./dist/workspace-frame.d.ts",
      "workbench-source": "./src/workspace-frame.ts",
      "import": "./dist/workspace-frame.js"
    },
    "./frame-layout": {
      "types": "./dist/frame/layout.d.ts",
      "workbench-source": "./src/frame/layout.ts",
      "import": "./dist/frame/layout.js"
    },
    "./frame-theme": {
      "types": "./dist/frame/theme.d.ts",
      "workbench-source": "./src/frame/theme.ts",
      "import": "./dist/frame/theme.js"
    },
    "./workspace.css": "./workspace.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@dsiem/analytics": "workspace:*"
  },
  "peerDependencies": {
    "effect": "~4.1.4",
    "foldkit": "^0.171.0",
    "@foldkit/ui": "^0.171.0"
  }
}
