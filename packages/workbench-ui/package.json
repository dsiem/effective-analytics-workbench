{
  "name": "@dsiem/workbench-ui",
  "version": "0.1.0",
  "description": "Typed report components for Foldkit applications",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workbench-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./query-page": {
      "types": "./dist/query-page.d.ts",
      "workbench-source": "./src/query-page.ts",
      "import": "./dist/query-page.js"
    },
    "./findings": {
      "types": "./dist/findings.d.ts",
      "workbench-source": "./src/findings.ts",
      "import": "./dist/findings.js"
    },
    "./styles.css": "./styles.css",
    "./record-explorer": {
      "types": "./dist/record-explorer.d.ts",
      "workbench-source": "./src/record-explorer.ts",
      "import": "./dist/record-explorer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@dsiem/analytics": "workspace:*"
  },
  "peerDependencies": {
    "effect": "~4.1.4",
    "foldkit": "^0.171.0"
  }
}
