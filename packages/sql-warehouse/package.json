{
  "name": "@dsiem/sql-warehouse",
  "version": "0.1.0",
  "description": "Effect 4 adapter for Databricks SQL warehouses with inline JSON and Apache Arrow results",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsiem/effective-analytics-workbench.git",
    "directory": "packages/sql-warehouse"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workbench-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:live": "node --env-file-if-exists=../../.env scripts/live.mjs",
    "presmoke:live": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "effect": "~4.1.4"
  },
  "dependencies": {
    "apache-arrow": "21.2.0"
  }
}
