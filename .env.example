# Use these settings when starting the app with pnpm run dev directly.
# For a deployed bundle target, run databricks bundle run app-local -t dev.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
# Fully qualified snapshot table in the form <data_catalog>.<data_schema>.trips.
TRIP_SNAPSHOT_TABLE=
ANALYSIS_JOB_ID=
ANALYSIS_RESULTS_TABLE=
DATABRICKS_CONFIG_PROFILE=
GENIE_SPACE_ID=
LAKEBASE_ENDPOINT=
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=

# Optional alternatives; keep credentials server-side and out of version control.
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# PGPASSWORD=
