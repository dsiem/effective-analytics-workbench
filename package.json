{
  "name": "effective-analytics-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "packageManager": "pnpm@11.29.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "corepack pnpm -r run build && tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/src/main.js",
    "typecheck": "pnpm -r run build && pnpm -r run typecheck && tsc --noEmit && tsc -p client",
    "lint": "pnpm -r run build && oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "test": "pnpm -r run test && node --conditions=development --conditions=workbench-source --import tsx --test server/test/*.test.ts test/*.test.ts client/test/*.test.ts",
    "test:scene": "node --conditions=development --conditions=workbench-source --import tsx --test client/test/*.scene.test.ts",
    "test:dist": "node --test server/test/built/*.test.mjs test/built/*.test.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:dist",
    "db:setup": "node --env-file-if-exists=.env --import tsx --conditions=workbench-source scripts/setup-lakebase.ts",
    "test:browser": "playwright test",
    "test:browser:deployed": "playwright test --config client/test/deployed/playwright.config.ts",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@deck.gl/core": "9.4.2",
    "@deck.gl/layers": "9.4.2",
    "@deck.gl/maplibre": "9.4.2",
    "@dsiem/analytics": "workspace:*",
    "@dsiem/analytics-shared": "workspace:*",
    "@dsiem/genie-client": "workspace:*",
    "@dsiem/sql-warehouse": "workspace:*",
    "@dsiem/workbench-ui": "workspace:*",
    "@effect/platform-browser": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@foldkit/ui": "0.171.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "effect": "4.1.5",
    "foldkit": "0.171.0",
    "maplibre-gl": "6.19.0",
    "marked": "17.0.6",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electric-sql/pglite": "0.5.17",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@playwright/test": "1.65.1",
    "apache-arrow": "21.2.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "4.23.15"
  }
}
